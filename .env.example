# ============================================================================
# Shahbaz Health Dashboard - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control
# ============================================================================

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# xAI Grok API Configuration (Server-side only, for Vercel Functions)
# Get your API key from: https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# Optional: Fitbit/Google Health Integration
FITBIT_CLIENT_ID=your_fitbit_client_id
FITBIT_CLIENT_SECRET=your_fitbit_client_secret

# Optional: ElevenLabs Voice Agent (not yet implemented)
VITE_ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id
